          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_content_fts_BEFORE_UPDATE BEFORE UPDATE ON `content_items` BEGIN DELETE FROM `content_fts` WHERE `docid`=OLD.`rowid`; END",
